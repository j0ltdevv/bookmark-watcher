[Unit]
Description=Bookmark watcher X -> Telegram (Siftly)
# Nécessite une session X valide : lance d'abord `python watcher.py login`
After=siftly.service nvidia-claude-proxy.service

[Service]
Type=simple
WorkingDirectory=~/Documents/Default Project/bookmark-watcher
ExecStart=~/Documents/Default Project/bookmark-watcher/venv/bin/python watcher.py daemon
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
